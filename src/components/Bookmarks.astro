<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="status" class="status" role="status" aria-live="polite"></p>

<p id="empty-state" class="empty">No bookmarks yet - add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <template id="bookmark-template">
    <li class="bookmark">
      <a class="url" target="_blank" rel="noopener noreferrer"></a>
      <span class="separator" aria-hidden="true"> :: </span>
      <span class="slug"></span>
      <button type="button" class="copy">Copy</button>
    </li>
  </template>
</ul>

<script>
  import {
    formatBookmark,
    nextSlug,
    normalizeUrl,
    parseBookmarks,
    type Bookmark,
  } from '../lib/bookmarks';

  const STORAGE_KEY = 'mona-bookmarks';
  const form = document.querySelector<HTMLFormElement>('#add-bookmark');
  const urlInput = document.querySelector<HTMLInputElement>('#url');
  const list = document.querySelector<HTMLUListElement>('#bookmark-list');
  const template = document.querySelector<HTMLTemplateElement>('#bookmark-template');
  const emptyState = document.querySelector<HTMLParagraphElement>('#empty-state');
  const listHeader = document.querySelector<HTMLDivElement>('#list-header');
  const clearButton = document.querySelector<HTMLButtonElement>('#clear-all');
  const status = document.querySelector<HTMLParagraphElement>('#status');

  let bookmarks = loadBookmarks();
  renderBookmarks();

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!urlInput) {
      return;
    }

    urlInput.setCustomValidity('');

    let url: string;
    try {
      url = normalizeUrl(urlInput.value);
    } catch (error) {
      urlInput.setCustomValidity(error instanceof Error ? error.message : 'Enter a valid URL.');
      urlInput.reportValidity();
      return;
    }

    const bookmark: Bookmark = { url, slug: nextSlug(bookmarks) };
    const nextBookmarks = [...bookmarks, bookmark];

    if (!saveBookmarks(nextBookmarks)) {
      return;
    }

    bookmarks = nextBookmarks;
    form.reset();
    setStatus(`Saved ${formatBookmark(bookmark)}`);
    renderBookmarks();
    urlInput.focus();
  });

  clearButton?.addEventListener('click', () => {
    if (!window.confirm('Remove all saved bookmarks?')) {
      return;
    }

    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      setStatus('Bookmarks could not be cleared because browser storage is unavailable.', true);
      return;
    }

    bookmarks = [];
    setStatus('All bookmarks cleared.');
    renderBookmarks();
  });

  function loadBookmarks(): Bookmark[] {
    try {
      return parseBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      setStatus('Saved bookmarks could not be loaded because browser storage is unavailable.', true);
      return [];
    }
  }

  function saveBookmarks(nextBookmarks: Bookmark[]): boolean {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(nextBookmarks));
      return true;
    } catch {
      setStatus('The bookmark could not be saved because browser storage is unavailable.', true);
      return false;
    }
  }

  function renderBookmarks(): void {
    if (!list || !template || !emptyState || !listHeader) {
      return;
    }

    list.querySelectorAll('.bookmark').forEach((item) => item.remove());

    for (const bookmark of bookmarks) {
      const item = template.content.firstElementChild?.cloneNode(true);
      if (!(item instanceof HTMLLIElement)) {
        continue;
      }

      const link = item.querySelector<HTMLAnchorElement>('.url');
      const slug = item.querySelector<HTMLElement>('.slug');
      const copyButton = item.querySelector<HTMLButtonElement>('.copy');

      if (!link || !slug || !copyButton) {
        continue;
      }

      link.href = bookmark.url;
      link.textContent = bookmark.url;
      slug.textContent = bookmark.slug;
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          setStatus(`Copied ${bookmark.slug}`);
        } catch {
          setStatus('The slug could not be copied to the clipboard.', true);
        }
      });

      list.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  function setStatus(message: string, isError = false): void {
    if (!status) {
      return;
    }

    status.textContent = message;
    status.classList.toggle('error', isError);
  }
</script>
